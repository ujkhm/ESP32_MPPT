# -------------------------------
# 1. KiCad 电路设计文件
# -------------------------------
# 额外忽略 KiCad 的特殊临时文件
KiCad/#auto_saved_files#/
KiCad/KiCad-backups/
KiCad/~*.lck
# 临时与备份文件
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
*.sch-bak
*~
_autosave-*
*-save.pro
*-save.kicad_pcb

# 自动生成的缓存
fp-info-cache
# 编译/导出的中间文件
/build
# 生成的网表文件
*.net
# 自动布线文件
*.dsn
*.ses
# 导出的BOM物料清单
*.xml
*.csv
*.tsv
# 杂项日志文件
*.log
*.raw
# 第三方工具缓存
.svg2shenzhen-cache

# -------------------------------
# 2. Visual Studio Code (VSCode)
# -------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# -------------------------------
# 3. ESP-IDF (ESP32 开发框架)
# -------------------------------
# 编译生成的二进制文件
build/
build_*_*/
# 配置文件
sdkconfig
# Python 缓存
__pycache__/
.pytest_cache/
# IDF 工具生成的文件
pytest_embedded_log/
dependencies.lock

# -------------------------------
# 4. 系统或通用临时文件
# -------------------------------
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
